{
  "name": "@playground/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts src/worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "db:migrate": "tsx src/migrate.ts",
    "admin:create": "tsx src/bootstrap.ts",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@inquirer/input": "^4.3.1",
    "@inquirer/password": "^4.0.23",
    "@playground/shared": "workspace:*",
    "argon2": "^0.44.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.0",
    "sharp": "^0.34.5",
    "tar-stream": "^3.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/tar-stream": "^3.1.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
